# ==============================================================================
# ตัวอย่างไฟล์ตั้งค่าตัวแปรสภาพแวดล้อม (Environment Variables)
# คัดลอกชื่อตัวแปรเหล่านี้ไปใส่ค่าจริงในไฟล์ .env.local (ห้ามใส่คีย์จริงลงในไฟล์นี้)
# ==============================================================================

# --- Supabase (ดูจากหน้า Project Settings > API Keys หรือปุ่ม Connect) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# กุญแจลับสำหรับฝั่ง Server เท่านั้น (ห้ามตั้งชื่อขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด)
SUPABASE_SECRET_KEY=

# --- Resend (ดูจากหน้า Resend Dashboard > API Keys) ---
RESEND_API_KEY=
